# ==================================================
# CONFIGURAÇÃO DO WEATHER SERVICE
# ==================================================
# 
# Este arquivo serve como exemplo para criar seu .env
# Copie este arquivo para .env e configure as variáveis
#
# Comando: cp env.example .env
#

# --------------------------------------------------
# CONFIGURAÇÕES DO SERVIDOR
# --------------------------------------------------

# Porta onde o servidor irá rodar
# Padrão: 3001 (se não especificado)
PORT=3001

# --------------------------------------------------
# API EXTERNA - OPENWEATHERMAP
# --------------------------------------------------

# Chave da API do OpenWeatherMap (OBRIGATÓRIO)
# 
# PARA TESTES/DESENVOLVIMENTO:
# Use a chave abaixo para começar imediatamente
OPENWEATHER_API_KEY=b6907d289e10d714a6e88b30761fae22
#

# --------------------------------------------------
# CONFIGURAÇÕES OPCIONAIS (futuras expansões)
# --------------------------------------------------

# Ambiente da aplicação (development, production, test)
# NODE_ENV=development


# Timeout para requisições HTTP (em milissegundos)
# HTTP_TIMEOUT=5000

# Limite de requisições por minuto (rate limiting)
# RATE_LIMIT=100
